{
  "rewrites": [
    {
      "source": "/storage/v1/object/public/cyclone-uploads/:path*",
      "destination": "/api/media?bucket=cyclone-uploads&path=:path*"
    },
    {
      "source": "/media/uploads/:path*",
      "destination": "/api/media?bucket=uploads&path=:path*"
    },
    {
      "source": "/media/cyclone-uploads/:path*",
      "destination": "/api/media?bucket=cyclone-uploads&path=:path*"
    },
    {
      "source": "/tornado.html/:slug",
      "destination": "/tornado.html"
    },
    {
      "source": "/outbreak.html/:slug",
      "destination": "/outbreak.html"
    }
  ],
  "headers": [
    {
      "source": "/media-archive/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
