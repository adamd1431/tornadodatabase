{
  "buildCommand": "node scripts/refresh-ibtracs.mjs --recent --keep-on-error && node scripts/refresh-satellite-tracks.mjs --recent --keep-on-error && node scripts/refresh-public-recovery.mjs --keep-on-error && node scripts/refresh-motis.mjs --keep-on-error",
  "outputDirectory": ".",
  "functions": {
    "api/poci-roci-chart.js": {
      "maxDuration": 60
    },
    "api/poci-roci.js": {
      "maxDuration": 60,
      "includeFiles": "ibtracs-data/*.json.gz"
    },
    "api/ibtracs-media.js": {
      "maxDuration": 60
    },
    "api/jtwc-report.js": {
      "maxDuration": 60,
      "includeFiles": "server-vendor/pdfjs-4.8.69/*.mjs"
    },
    "api/mcfetch.js": {
      "maxDuration": 60
    },
    "api/live-storms.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/storage/v1/object/public/cyclone-uploads/:path*",
      "destination": "/api/media?bucket=cyclone-uploads&path=:path*"
    },
    {
      "source": "/media/uploads/:path*",
      "destination": "/api/media?bucket=uploads&path=:path*"
    },
    {
      "source": "/media/cyclone-uploads/:path*",
      "destination": "/api/media?bucket=cyclone-uploads&path=:path*"
    },
    {
      "source": "/tornado.html/:slug",
      "destination": "/tornado.html"
    },
    {
      "source": "/outbreak.html/:slug",
      "destination": "/outbreak.html"
    },
    {
      "source": "/tropical-cyclone.html/:slug",
      "destination": "/tropical-cyclone.html"
    }
  ],
  "headers": [
    {
      "source": "/public-data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/media-archive/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/ibtracs-data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/motis-data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
