{
  "routes": [
    {
      "src": "^/media/uploads/(.+)$",
      "dest": "https://kxhqfwlfendphhwurhcg.supabase.co/storage/v1/object/public/uploads/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1",
        "Cache-Control": "public, max-age=86400",
        "Vercel-CDN-Cache-Control": "public, max-age=86400",
        "Vercel-Cache-Tag": "storm-media"
      },
      "transforms": [
        {
          "type": "response.headers",
          "op": "delete",
          "target": {
            "key": "set-cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "authorization"
          }
        }
      ]
    },
    {
      "src": "^/media/cyclone-uploads/(.+)$",
      "dest": "https://kxhqfwlfendphhwurhcg.supabase.co/storage/v1/object/public/cyclone-uploads/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1",
        "Cache-Control": "public, max-age=86400",
        "Vercel-CDN-Cache-Control": "public, max-age=86400",
        "Vercel-Cache-Tag": "storm-media"
      },
      "transforms": [
        {
          "type": "response.headers",
          "op": "delete",
          "target": {
            "key": "set-cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "cookie"
          }
        },
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "authorization"
          }
        }
      ]
    },
    {
      "src": "^/tornado\\.html/([^/]+)$",
      "dest": "/tornado.html"
    },
    {
      "src": "^/outbreak\\.html/([^/]+)$",
      "dest": "/outbreak.html"
    }
  ]
}
